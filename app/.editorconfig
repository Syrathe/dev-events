# Top-most EditorConfig file
root = true

# All files
[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# 4-space exceptions (if you use any of these)
[*.{java,py}]
indent_size = 4

# Markdown — preserve trailing whitespace (line breaks use 2 spaces)
[*.md]
trim_trailing_whitespace = false